{
  "name": "rossbus-mcp",
  "version": "1.2.1",
  "description": "MCP server for intercity bus travel across Russia: routes, prices, schedules, transfers, price-per-km index. Remote server at https://rossbus.ru/mcp",
  "type": "module",
  "main": "mcp.js",
  "scripts": {
    "start": "node mcp.js",
    "build:ui": "vite build --config ui/vite.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xpressmike/rossbus-mcp"
  },
  "homepage": "https://rossbus.ru/agents/",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "travel",
    "bus",
    "russia",
    "schedule",
    "transport"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
